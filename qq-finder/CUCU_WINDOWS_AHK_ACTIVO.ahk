#Requires AutoHotkey v2.0
#SingleInstance Force

; ==============================================================================
; CONFIGURACIÓN Y MOTOR DE PEGADO
; ==============================================================================

PasteText(text, *) {
    A_Clipboard := ""
    Sleep 80
    A_Clipboard := text
    if !ClipWait(2) {
        MsgBox "Clipboard did not load."
        return
    }
    Sleep 80
    SendInput "{Ctrl down}v{Ctrl up}"
}

; ==============================================================================
; ACCIONES LOCALES · ADRI TYPE / WINDOWS
; ==============================================================================

StartDesktopCommander(*) {
    ; qqdc: arranque normal, evita duplicar el agente conectado.
    Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' A_ScriptDir '\QQ_DC_CONNECT.ps1" -Mode Start', , "Hide")
}

RestartDesktopCommander(*) {
    ; qqdcr: recuperacion escalonada, sin matar una sesion activa.
    Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' A_ScriptDir '\QQ_DC_CONNECT.ps1" -Mode Recover')
}

RunAdriAction(action) {
    global Snippets
    if (SubStr(action, 1, 7) = "copyqq:") {
        trigger := SubStr(action, 8)
        if Snippets.Has(trigger)
            A_Clipboard := Snippets[trigger]
        return
    }
    switch action {
        case "ahk_reload": Reload()
        case "dc_start": StartDesktopCommander()
        case "dc_restart": RestartDesktopCommander()
        case "monitor_off": SendMessage(0x112, 0xF170, 2, , "Program Manager")
        case "task_manager": Run("taskmgr.exe")
        case "powershell": Run("powershell.exe")
        case "startup_apps": Run("ms-settings:startupapps")
        case "clipboard_history": Send("#v")
        case "screenshot": Send("#+s")
        case "show_desktop": Send("#d")
        case "run_dialog": Send("#r")
        case "file_explorer": Run("explorer.exe")
        case "open_qq_folder": Run('explorer.exe "C:\Users\adria\My Drive\#qqpromps"')
        case "open_adri_type": Run('explorer.exe "C:\Users\adria\Documents\GitHub\adrian-typing-tracker"')
    }
}

WatchAdriTypeCommands() {
    prefix := "__ADRI_CMD__:"
    clip := A_Clipboard
    if (Type(clip) != "String")
        return
    if (SubStr(clip, 1, StrLen(prefix)) != prefix)
        return
    action := Trim(SubStr(clip, StrLen(prefix) + 1))
    A_Clipboard := ""
    RunAdriAction(action)
}

SetTimer(WatchAdriTypeCommands, 100)

